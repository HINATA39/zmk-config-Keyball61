#define DEFAULT 0
#define NUM     1
#define SYM     2
#define FUN     3
#define MOUSE   4
#define SCROLL  5
#define SNIPE   6

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp ESC     &kp N1     &kp N2     &kp N3     &kp N4          &kp N5                                        &kp N6          &kp N7  &kp N8     &kp N9   &kp N0      &kp BSPC
&kp TAB     &kp Q      &kp W      &kp E      &kp R           &kp T                                         &kp Y           &kp U   &kp I      &kp O    &kp P       &kp MINUS
&kp LCTRL   &kp A      &kp S      &kp D      &kp F           &kp G                                         &kp H           &kp J   &kp K      &kp L    &kp QUOTE   &kp ENTER
&kp LSHIFT  &kp Z      &kp X      &kp C      &kp V           &kp B          &none         &none            &kp N           &kp M   &kp COMMA  &kp DOT  &kp FSLH    &kp RSHIFT
&mo NUM     &kp LCTRL  &kp LGUI   &kp LALT   &mt LGUI LANG2  &lt SYM SPACE  &lt FUN BSPC  &lt SYM SPACE    &mt RGUI LANG1                              &mo SCROLL  &kp RSHIFT
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&trans  &kp N1     &kp N2     &kp N3   &kp N4      &kp N5                  &kp N6     &kp N7        &kp N8        &kp N9     &kp N0  &trans
&trans  &trans     &trans     &trans   &trans      &trans                  &trans     &kp HOME      &kp UP        &kp END    &trans  &trans
&trans  &kp LEFT   &kp DOWN   &kp UP   &kp RIGHT   &trans                  &kp BSPC   &kp LEFT      &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans     &trans     &trans   &trans      &trans  &none  &none    &trans     &trans        &trans        &trans     &trans  &trans
&trans  &trans     &trans     &trans   &trans      &trans  &trans          &trans     &trans                                &trans  &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&trans  &trans    &trans    &trans   &trans     &trans                  &trans  &trans  &trans  &kp EQUAL  &kp INT3   &trans
&trans  &trans    &trans    &trans   &trans     &trans                  &trans  &trans  &trans  &kp LBKT   &kp RBKT   &trans
&trans  &kp LEFT  &kp DOWN  &kp UP   &kp RIGHT  &trans                  &trans  &trans  &trans  &trans     &kp NUHS   &trans
&trans  &trans    &trans    &trans   &trans     &trans  &none  &none    &trans  &trans  &trans  &trans     &kp INT1   &trans
&trans  &trans    &trans    &trans   &trans     &trans  &trans          &trans  &trans                                &trans  &trans
            >;
        };

        function_layer {
            label = "FUN";
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5                  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &kp F11
&trans  &trans   &trans   &trans   &trans   &trans                  &trans   &trans   &trans   &trans   &trans   &kp F12
&trans  &trans   &trans   &trans   &trans   &trans                  &trans   &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &trans   &trans   &trans  &none  &none    &trans   &trans   &trans   &trans   &trans   &trans
&trans  &trans   &trans   &trans   &trans   &trans  &trans          &trans   &trans                             &trans  &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans  &trans     &trans                       &trans         &trans     &trans  &trans     &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans                       &trans         &trans     &trans  &trans     &trans     &trans
&trans  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans                       &kp PAGE_UP    &mkp LCLK  &trans  &mkp RCLK  &mkp MCLK  &trans
&trans  &trans    &trans    &trans  &trans     &trans  &none      &none        &kp PAGE_DOWN  &trans     &trans  &trans     &trans     &trans
&trans  &trans    &trans    &trans  &trans     &trans  &trans     &mo SNIPE    &trans                                              &trans  &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                          &trans  &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &mkp MB4   &trans  &mkp MB5   &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none  &none    &trans  &trans     &trans  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans                                &trans  &trans
            >;
        };
    };
};
